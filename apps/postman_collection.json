{
  "info": {
    "name": "SmartHome API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Register sensor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/sensors",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "sensors"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_id\": \"sensor-001\",\n  \"type\": \"sensor\",\n  \"location\": \"Living Room\"\n}"
        }
      },
      "response": [
        {
          "name": "201 Created",
          "status": "Created",
          "code": 201,
          "body": "{\n  \"id\": 1,\n  \"device_id\": \"sensor-001\",\n  \"type\": \"sensor\",\n  \"location\": \"Living Room\",\n  \"created_at\": \"2026-09-19T18:50:00Z\"\n}"
        },
        {
          "name": "400 Bad Request",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"error\": \"device_id and location are required\"\n}"
        },
        {
          "name": "409 Conflict",
          "status": "Conflict",
          "code": 409,
          "body": "{\n  \"error\": \"Sensor with this device_id already exists\"\n}"
        }
      ]
    },
    {
      "name": "Get all sensors",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/sensors",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "sensors"
          ]
        }
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "body": "[\n  {\n    \"id\": 1,\n    \"device_id\": \"sensor-001\",\n    \"type\": \"sensor\",\n    \"location\": \"Living Room\",\n    \"created_at\": \"2026-09-19T18:50:00Z\"\n  },\n  {\n    \"id\": 2,\n    \"device_id\": \"sensor-002\",\n    \"type\": \"motion\",\n    \"location\": \"Kitchen\",\n    \"created_at\": \"2026-09-19T18:51:00Z\"\n  }\n]"
        }
      ]
    }
  ]
}